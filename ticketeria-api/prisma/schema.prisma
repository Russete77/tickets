// ============================================
// Ticketeria Digital - Schema Prisma Completo
// PostgreSQL 16 (Supabase)
// ============================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  consumer
  producer
  admin
}

enum EventStatus {
  draft
  published
  cancelled
  finished
}

enum EventCategory {
  show
  festival
  esporte
  teatro
  museu
  curso
  outro
}

enum BatchType {
  regular
  vip
  backstage
  camarote
}

enum OrderStatus {
  pending
  paid
  cancelled
  refunded
}

enum PaymentMethod {
  pix
  credit_card
  boleto
}

enum TicketStatus {
  active
  used
  transferred
  cancelled
  refunded
}

enum TransferStatus {
  pending
  confirmed
  cancelled
  expired
}

enum CheckinResult {
  valid
  invalid_hash
  invalid_totp
  already_used
  wrong_event
  ticket_cancelled
  offline_valid
  offline_conflict
}

enum DiscountType {
  percentage
  fixed
}

enum NotificationType {
  email
  push
  in_app
}

enum NotificationChannel {
  email
  push
  in_app
}

enum CompanyType {
  MEI
  ME
  EPP
  LTDA
  SA
  INDIVIDUAL
}

enum AsaasAccountStatus {
  pending
  approved
  rejected
  suspended
}

enum DocumentsStatus {
  pending
  sent
  approved
  rejected
}

enum GuestListType {
  free
  vip
  backstage
  press
}

enum MediaType {
  image
  video
}

// ============================================
// NEW ENUMS - PLATFORM EXPANSION
// ============================================

enum TicketPriceType {
  inteira
  meia_estudante
  meia_idoso
  meia_pcd
  meia_jovem
  meia_social
  cortesia
  promocional
  crianca
}

enum GuestListStatus {
  active
  closed
  archived
}

enum GuestEntryStatus {
  pending
  confirmed
  checked_in
  rejected
  no_show
}

enum PromoterTier {
  bronze
  silver
  gold
  platinum
  diamond
}

enum CourtesyStatus {
  courtesy_pending
  approved
  issued
  courtesy_used
  courtesy_expired
  revoked
}

enum WalletType {
  digital
  wristband
  card
}

enum WalletStatus {
  wallet_active
  blocked
  refund_pending
  wallet_refunded
  wallet_expired
}

enum CashlessTransactionType {
  topup
  purchase
  cashless_refund
  wallet_transfer
  cashout
  courtesy_credit
}

enum CashlessTransactionStatus {
  tx_completed
  tx_pending
  tx_failed
  reversed
}

enum ProductCategoryEnum {
  beer
  drink
  cocktail
  soft_drink
  water
  food
  snack
  merch
  service
  other

  @@map("ProductCategory")
}

enum POSType {
  bar
  mobile
  totem
  vip_lounge
  food_truck
  backstage_pos
}

enum StockMovementType {
  stock_entry
  sale
  loss
  adjustment
  stock_transfer
}

enum StaffRole {
  coordinator
  checkin_op
  cashier
  bartender
  security_staff
  promoter_op
  vip_host
  runner
  medic
  tech
  custom
}

enum StoreItemType {
  upgrade
  merchandise
  parking
  locker
  fast_lane
  meet_greet
  after_party
  food_combo
  cashless_credit
}

// ============================================
// TABELAS
// ============================================

model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String    @unique @db.VarChar(255)
  cpf                String    @unique @db.VarChar(14)
  name               String    @db.VarChar(255)
  phone              String?   @db.VarChar(20)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  totpSecret         String?   @map("totp_secret") @db.VarChar(64)
  totpEnabled        Boolean   @default(false) @map("totp_enabled")
  expoPushToken      String?   @map("expo_push_token") @db.VarChar(255)
  deviceFingerprints Json      @default("[]") @map("device_fingerprints") @db.JsonB
  role               UserRole  @default(consumer)
  emailVerified      Boolean   @default(false) @map("email_verified")
  avatarUrl          String?   @map("avatar_url") @db.VarChar(500)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relações
  producerProfile    Producer?
  eventsAsProducer   Event[]           @relation("EventProducer")
  orders             Order[]
  ticketsAsHolder    Ticket[]          @relation("TicketHolder")
  ticketsAsBuyer     Ticket[]          @relation("TicketBuyer")
  checkinOperations  Ticket[]          @relation("TicketCheckinOperator")
  transfersFrom      TicketTransfer[]  @relation("TransferFrom")
  transfersTo        TicketTransfer[]  @relation("TransferTo")
  checkinLogs        CheckinLog[]      @relation("CheckinOperator")
  affiliateLinks     AffiliateLink[]
  reviews            EventReview[]
  notifications      Notification[]
  auditActions       AuditLog[]
  favorites          Favorite[]
  permissions        Permission[]
  waitlists          Waitlist[]
  promoterProfile2   Promoter?         @relation("PromoterUser")
  cashlessWallets    CashlessWallet[]
  posOperations      POSOperator[]
  certificates       Certificate[]
  boxOfficeSessions  BoxOfficeSession[] @relation("BoxOfficeOperator")
  customerOrders     CustomerOrder[]
  friendshipsSent     Friendship[]      @relation("FriendshipRequester")
  friendshipsReceived Friendship[]      @relation("FriendshipAddressee")
  achievements        UserAchievement[] @relation("UserAchievements")

  @@map("users")
}

model Producer {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String             @unique @map("user_id") @db.Uuid
  companyName           String             @map("company_name") @db.VarChar(255)
  cnpj                  String?            @unique @db.VarChar(18)
  companyType           CompanyType        @map("company_type")
  asaasAccountId        String             @unique @map("asaas_account_id") @db.VarChar(100)
  asaasApiKeyEncrypted  String             @map("asaas_api_key_encrypted") @db.Text
  asaasWalletId         String             @map("asaas_wallet_id") @db.VarChar(100)
  asaasStatus           AsaasAccountStatus @default(pending) @map("asaas_status")
  onboardingUrl         String?            @map("onboarding_url") @db.VarChar(500)
  platformFeePercent    Decimal            @default(10.00) @map("platform_fee_percent") @db.Decimal(5, 2)
  bankAccount           Json?              @map("bank_account") @db.JsonB
  documentsStatus       DocumentsStatus    @default(pending) @map("documents_status")
  approvedAt            DateTime?          @map("approved_at") @db.Timestamptz
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("producers")
}

model Event {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  producerId         String        @map("producer_id") @db.Uuid
  // Multi-tenant migration — Auditoria CTO 2026-05 (gap 4.1)
  // NOT NULL desde a migration event_drop_legacy_producer (2026-06-01).
  organizationId     String        @map("organization_id") @db.Uuid
  title              String        @db.VarChar(255)
  slug               String        @unique @db.VarChar(255)
  description        String        @db.Text
  shortDescription   String        @map("short_description") @db.VarChar(500)
  category           EventCategory
  status             EventStatus   @default(draft)
  venueName          String        @map("venue_name") @db.VarChar(255)
  venueAddress       String        @map("venue_address") @db.Text
  venueLat           Decimal?      @map("venue_lat") @db.Decimal(10, 8)
  venueLng           Decimal?      @map("venue_lng") @db.Decimal(11, 8)
  venueCapacity      Int           @map("venue_capacity")
  startsAt           DateTime      @map("starts_at") @db.Timestamptz
  endsAt             DateTime      @map("ends_at") @db.Timestamptz
  doorsOpenAt        DateTime?     @map("doors_open_at") @db.Timestamptz
  coverImageUrl      String        @map("cover_image_url") @db.VarChar(500)
  gallery            Json          @default("[]") @db.JsonB
  tags               String[]      @default([])
  ageRating          String        @default("Livre") @map("age_rating") @db.VarChar(10)
  dressCode          String?       @map("dress_code") @db.VarChar(100)
  isOpenBar          Boolean       @default(false) @map("is_open_bar")
  lineup             Json          @default("[]") @db.JsonB
  rules              String?       @db.Text
  maxTicketsPerCpf   Int           @default(4) @map("max_tickets_per_cpf")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // Relações
  producer           User                @relation("EventProducer", fields: [producerId], references: [id])
  batches            TicketBatch[]
  orders             Order[]
  tickets            Ticket[]
  checkinLogs        CheckinLog[]
  reviews            EventReview[]
  guestLists         GuestList[]
  media              EventMedia[]
  coupons            Coupon[]
  affiliateLinks     AffiliateLink[]
  favorites          Favorite[]
  permissions        Permission[]
  courtesies         Courtesy[]
  waitlists          Waitlist[]
  guestListConfig    GuestListConfig?
  cashlessConfig     CashlessConfig?
  cashlessWallets    CashlessWallet[]
  pointsOfSale       PointOfSale[]
  eventStaff         EventStaff[]
  eventAreas         EventArea[]
  storeItems         StoreItem[]
  formFields         EventFormField[]
  credentials        Credential[]
  certificates       Certificate[]
  insurance          EventInsurance?
  boxOfficeSessions  BoxOfficeSession[]
  productCategories  ProductCategory[]
  customerOrders     CustomerOrder[]
  venueMap           VenueMap?

  // Índices
  @@index([status, startsAt, category], name: "idx_events_search")
  @@index([slug], name: "idx_events_slug")
  @@index([organizationId])
  @@map("events")
}

/// Engine 5 Sprint 3 — Mapa do venue (SVG + zonas clicáveis)
model VenueMap {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String   @unique @map("event_id") @db.Uuid
  svgUrl    String?  @map("svg_url") @db.VarChar(500)
  zones     Json     @default("[]") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("venue_maps")
}

/// Engine 5 Sprint 5 — Social: amizades entre usuários
enum FriendshipStatus {
  pending
  accepted
  blocked
}

model Friendship {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId  String           @map("requester_id") @db.Uuid
  addresseeId  String           @map("addressee_id") @db.Uuid
  status       FriendshipStatus @default(pending)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  requester    User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee    User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendships")
}

/// Engine 5 Sprint 6 — Gamificação: badges e conquistas
model Achievement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String   @db.VarChar(500)
  iconUrl     String?  @map("icon_url") @db.VarChar(500)
  tier        Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  achievementId String      @map("achievement_id") @db.Uuid
  progress      Int         @default(0)
  unlockedAt    DateTime?   @map("unlocked_at") @db.Timestamptz
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user        User        @relation("UserAchievements", fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
  @@map("user_achievements")
}

model TicketBatch {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  priceCents  Int       @map("price_cents")
  quantity    Int
  soldCount   Int       @default(0) @map("sold_count")
  sortOrder   Int       @default(0) @map("sort_order")
  type        BatchType @default(regular)
  startsAt    DateTime? @map("starts_at") @db.Timestamptz
  endsAt      DateTime? @map("ends_at") @db.Timestamptz
  autoSwitch  Boolean   @default(true) @map("auto_switch")
  isVisible   Boolean   @default(true) @map("is_visible")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relações
  event      Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets    Ticket[]
  priceRules TicketPriceRule[]

  @@map("ticket_batches")
}

model Order {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  eventId           String        @map("event_id") @db.Uuid
  status            OrderStatus   @default(pending)
  totalCents        Int           @map("total_cents")
  platformFeeCents  Int           @map("platform_fee_cents")
  paymentMethod     PaymentMethod @map("payment_method")
  asaasPaymentId    String?       @map("asaas_payment_id") @db.VarChar(100)
  asaasInvoiceUrl   String?       @map("asaas_invoice_url") @db.VarChar(500)
  // Multi-gateway — Auditoria CTO 2026-05 (gap 4.6)
  gatewayProvider   PaymentGatewayProvider? @map("gateway_provider")
  gatewayPaymentId  String?       @map("gateway_payment_id") @db.VarChar(100)
  gatewayRaw        Json?         @map("gateway_raw") @db.JsonB
  pixQrCode         String?       @map("pix_qr_code") @db.Text
  pixCopyPaste      String?       @map("pix_copy_paste") @db.Text
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz
  ipAddress         String        @map("ip_address") @db.VarChar(45)
  userAgent         String        @map("user_agent") @db.Text
  deviceFingerprint String        @map("device_fingerprint") @db.VarChar(100)
  riskScore         Decimal       @default(0) @map("risk_score") @db.Decimal(5, 2)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz

  // Relações
  user          User           @relation(fields: [userId], references: [id])
  event         Event          @relation(fields: [eventId], references: [id])
  tickets       Ticket[]
  paymentSplits PaymentSplit[]

  // Índices
  @@index([userId, createdAt(sort: Desc)], name: "idx_orders_user")
  @@index([asaasPaymentId], name: "idx_orders_asaas")
  @@index([gatewayProvider, gatewayPaymentId], name: "idx_orders_gateway")
  @@map("orders")
}

model Ticket {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  batchId         String       @map("batch_id") @db.Uuid
  eventId         String       @map("event_id") @db.Uuid
  holderId        String       @map("holder_id") @db.Uuid
  originalBuyerId String       @map("original_buyer_id") @db.Uuid
  status          TicketStatus @default(active)
  ticketHash      String       @unique @map("ticket_hash") @db.VarChar(64)
  totpSecret      String       @map("totp_secret") @db.VarChar(64)
  holderName      String       @map("holder_name") @db.VarChar(255)
  holderCpf       String       @map("holder_cpf") @db.VarChar(14)
  holderEmail     String       @map("holder_email") @db.VarChar(255)
  priceCents      Int          @map("price_cents")
  checkedInAt     DateTime?    @map("checked_in_at") @db.Timestamptz
  checkedInBy     String?      @map("checked_in_by") @db.Uuid
  checkedInDevice String?      @map("checked_in_device") @db.VarChar(100)
  transferCount   Int          @default(0) @map("transfer_count")
  deviceFp        String?      @map("device_fp") @db.VarChar(128)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz

  // Relações
  order           Order            @relation(fields: [orderId], references: [id])
  batch           TicketBatch      @relation(fields: [batchId], references: [id])
  event           Event            @relation(fields: [eventId], references: [id])
  holder          User             @relation("TicketHolder", fields: [holderId], references: [id])
  originalBuyer   User             @relation("TicketBuyer", fields: [originalBuyerId], references: [id])
  checkinOperator User?            @relation("TicketCheckinOperator", fields: [checkedInBy], references: [id])
  transfers       TicketTransfer[]
  checkinLogs     CheckinLog[]

  // Índices
  @@index([ticketHash], name: "idx_tickets_hash")
  @@index([holderId, status], name: "idx_tickets_holder")
  @@index([eventId, status], name: "idx_tickets_event")
  @@index([deviceFp], name: "tickets_device_fp_idx")
  @@map("tickets")
}

model TicketTransfer {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId   String         @map("ticket_id") @db.Uuid
  fromUserId String         @map("from_user_id") @db.Uuid
  toUserId   String         @map("to_user_id") @db.Uuid
  status     TransferStatus @default(pending)
  otpCode    String?        @map("otp_code") @db.VarChar(6)
  otpExpiresAt DateTime?    @map("otp_expires_at") @db.Timestamptz
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  // Relações
  ticket   Ticket @relation(fields: [ticketId], references: [id])
  fromUser User   @relation("TransferFrom", fields: [fromUserId], references: [id])
  toUser   User   @relation("TransferTo", fields: [toUserId], references: [id])

  @@map("ticket_transfers")
}

model CheckinLog {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId   String        @map("ticket_id") @db.Uuid
  eventId    String        @map("event_id") @db.Uuid
  operatorId String        @map("operator_id") @db.Uuid
  deviceId   String        @map("device_id") @db.VarChar(100)
  result     CheckinResult
  metadata   Json?         @db.JsonB
  scannedAt  DateTime      @default(now()) @map("scanned_at") @db.Timestamptz

  // Relações
  ticket   Ticket @relation(fields: [ticketId], references: [id])
  event    Event  @relation(fields: [eventId], references: [id])
  operator User   @relation("CheckinOperator", fields: [operatorId], references: [id])

  // Índices
  @@index([eventId, scannedAt], name: "idx_checkin_event")
  @@map("checkin_logs")
}

model AffiliateLink {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId           String   @map("event_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  code              String   @unique @db.VarChar(50)
  clickCount        Int      @default(0) @map("click_count")
  conversionCount   Int      @default(0) @map("conversion_count")
  commissionPercent Decimal  @map("commission_percent") @db.Decimal(5, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relações
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@map("affiliate_links")
}

model Coupon {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String       @map("event_id") @db.Uuid
  code          String       @db.VarChar(50)
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)
  usageLimit    Int?         @map("usage_limit")
  usedCount     Int          @default(0) @map("used_count")
  startsAt      DateTime?    @map("starts_at") @db.Timestamptz
  endsAt        DateTime?    @map("ends_at") @db.Timestamptz
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  // Relações
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, code])
  @@map("coupons")
}

model EventReview {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  rating       Decimal  @db.Decimal(2, 1)
  organization Decimal? @db.Decimal(2, 1)
  sound        Decimal? @db.Decimal(2, 1)
  bar          Decimal? @db.Decimal(2, 1)
  experience   Decimal? @db.Decimal(2, 1)
  comment      String?  @db.Text
  photos       Json     @default("[]") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relações
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("event_reviews")
}

model Favorite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relações
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@map("favorites")
}

model Notification {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  type      NotificationType
  channel   NotificationChannel
  title     String             @db.VarChar(255)
  body      String             @db.Text
  read      Boolean            @default(false)
  metadata  Json?              @db.JsonB
  sentAt    DateTime           @default(now()) @map("sent_at") @db.Timestamptz

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, sentAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json?    @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
